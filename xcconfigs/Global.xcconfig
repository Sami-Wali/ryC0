DEVELOPMENT_TEAM[config=Debug] = DHD9M6P75C
DEVELOPMENT_TEAM[config=Release] = AAAAA11111

LIVECONTAINER_BUNDLE_IDENTIFIER = com.ry0.ryC0
// One private group for ryC0 and its bundled extensions.
APP_GROUP = group.com.ry0.ryC0
RYC0_KEYCHAIN_GROUP = com.ry0.ryC0.shared

// Public source for the version distributed as ryC0.
RYC0_SOURCE_URL = https:/$()/github.com/Sami-Wali/ryC0
